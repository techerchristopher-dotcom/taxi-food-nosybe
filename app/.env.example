# Copie ce fichier en `.env` et renseigne les valeurs.
# Clé PUBLIQUE (publishable/anon) — sûre à exposer côté client, protégée par la RLS.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Connexion Google : le flux utilisé est supabase.auth.signInWithOAuth (provider Google
# configuré CÔTÉ Supabase avec Client ID + Secret). Le Client ID Web ci-dessous sert de
# drapeau « config faite » côté app. Client IDs iOS/Android inutilisés avec ce flux.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# --- Connexion Facebook ---
# Le provider Facebook se configure CÔTÉ Supabase (Authentication -> Providers -> Facebook,
# App ID + App Secret d'une app Meta for Developers). L'App ID ci-dessous ne sert qu'à
# l'app comme drapeau « config Facebook faite » : tant qu'il est absent, le bouton affiche
# un message clair au lieu d'ouvrir une page d'erreur Facebook.
# EXPO_PUBLIC_FACEBOOK_APP_ID=
