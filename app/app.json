{
  "expo": {
    "name": "Taxi Food",
    "slug": "taxi-food-nosybe",
    "scheme": "taxifood",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#E8342A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chris97416.taxi-food-nosybe",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.chris97416.taxifoodnosybe",
      "adaptiveIcon": {
        "backgroundColor": "#E8342A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA8ZnyLO0mOb2lLfJu5_4sdXpjVB4HyEvg"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Taxi Food utilise ta position pour enregistrer précisément ton adresse de livraison."
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#E8342A",
          "defaultChannel": "commandes"
        }
      ],
      "expo-image",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.227662072769-91mcfidthj8ibi0k01sgrooi69n54cr8"
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "1040980255315507",
          "clientToken": "d0fe3606e80fa2a5093989e963d2532a",
          "displayName": "Taxi Food",
          "scheme": "fb1040980255315507",
          "isAutoInitEnabled": true,
          "autoLogAppEventsEnabled": false,
          "advertiserIDCollectionEnabled": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b6df484c-a629-42ec-8a47-8616b300cdf6"
      }
    },
    "owner": "chris97416"
  }
}
