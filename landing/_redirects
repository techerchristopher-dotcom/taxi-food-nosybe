# --- Normalisation d'URL ----------------------------------------------------
# Une regle par racine de langue : sans elles, /en/index.html et /it/index.html
# restent servis comme doublons de /en/ et /it/, et seul le canonical protege.
/index.html      /                              301!
/en/index.html   /en/                           301!
/it/index.html   /it/                           301!

# --- Raccourcis diffuses a la main (WhatsApp, cartes de visite) --------------
# Un raccourci mene a la page de SA langue : envoyer /partner a un restaurateur
# italien pour le faire atterrir sur une page francaise gache le lien.
/restaurateurs   /restaurants-partenaires/      301
/partenaire      /restaurants-partenaires/      301
/en/partner      /en/restaurant-partners/       301
/it/partner      /it/ristoranti-partner/        301

# --- Filet de securite domaine canonique ------------------------------------
# Toutes les URL absolues du site (canonical, og:image, sitemap, JSON-LD)
# pointent sur https://taxifood.rentanoo.com/. Tant que ce nom n'existe pas en
# DNS, une mise en ligne sur <site>.netlify.app publie deux pages dont le
# canonical designe un hote injoignable : Google les sort de l'index et aucun
# apercu ne s'affiche sur WhatsApp ou Facebook.
#
# ATTENTION, ce qui suit a ete VERIFIE le 2026-08-24 et contredit ce qu'on lit
# partout : definir taxifood.rentanoo.com comme "primary domain" ne suffit PAS.
# Le domaine a ete pose, le certificat emis, HTTPS force — et le sous-domaine
# taxifood-nosybe-landing.netlify.app continuait de repondre 200 avec le site
# entier, canonical compris. Quatre essais sur deux minutes, jamais de 301.
# Netlify ne redirige donc pas son propre sous-domaine vers le domaine
# principal ; il ne pose pas non plus de noindex dessus en production.
#
# Sans la regle ci-dessous, le site existe a deux adresses avec le meme
# contenu. Ne pas la retirer.
https://taxifood-nosybe-landing.netlify.app/*  https://taxifood.rentanoo.com/:splat  301!

# Suivi de commande depuis les e-mails : /o/<id>.
# Avec l'app installee, iOS et Android interceptent ce lien AVANT le reseau et
# ouvrent l'ecran de suivi. Sans l'app, la requete arrive ici et part sur le
# site de commande. Le repli est donc automatique, sans detection de navigateur
# — laquelle se trompe toujours sur un cas ou l'autre.
/o/*  https://taxifood.distripro207.com/order/:splat  302
