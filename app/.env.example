# Copie ce fichier en `.env` et renseigne les valeurs.
# Clé PUBLIQUE (publishable/anon) — sûre à exposer côté client, protégée par la RLS.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Client IDs OAuth Google (Google Cloud Console → identifiants OAuth 2.0).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
